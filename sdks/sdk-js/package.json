{
  "name": "@synapseone/sdk",
  "version": "0.9.1",
  "license": "Apache-2.0",
  "description": "synapseone SDK for JavaScript/TypeScript",
  "homepage": "https://synapseone.space",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vku-open-source-2026/SynapseOne.git",
    "directory": "sdks/sdk-js"
  },
  "bugs": {
    "url": "https://github.com/vku-open-source-2026/SynapseOne/issues"
  },
  "keywords": [
    "synapseone",
    "sdk",
    "paas",
    "iam",
    "workflow",
    "ngsi-ld",
    "document-db",
    "redis",
    "queue"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./iam": {
      "types": "./dist/iam.d.ts",
      "require": "./dist/iam.js",
      "default": "./dist/iam.js"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "require": "./dist/workflow.js",
      "default": "./dist/workflow.js"
    },
    "./lds": {
      "types": "./dist/lds.d.ts",
      "require": "./dist/lds.js",
      "default": "./dist/lds.js"
    },
    "./base": {
      "types": "./dist/base.d.ts",
      "require": "./dist/base.js",
      "default": "./dist/base.js"
    },
    "./faststore": {
      "types": "./dist/faststore.d.ts",
      "require": "./dist/faststore.js",
      "default": "./dist/faststore.js"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "require": "./dist/queue.js",
      "default": "./dist/queue.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "require": "./dist/stream.js",
      "default": "./dist/stream.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "require": "./dist/ai.js",
      "default": "./dist/ai.js"
    },
    "./inference": {
      "types": "./dist/inference.d.ts",
      "require": "./dist/inference.js",
      "default": "./dist/inference.js"
    },
    "./health": {
      "types": "./dist/health.d.ts",
      "require": "./dist/health.js",
      "default": "./dist/health.js"
    },
    "./package.json": "./package.json",
    "./storage": {
      "types": "./dist/storage.d.ts",
      "require": "./dist/storage.js",
      "default": "./dist/storage.js"
    },
    "./notifications": {
      "types": "./dist/notifications.d.ts",
      "require": "./dist/notifications.js",
      "default": "./dist/notifications.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/*.test.js",
    "lint": "echo lint-ok"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0"
  }
}
