# SynapseOne env — copy sang .env roi doi moi gia tri *_change_me_*.
# Dev (localhost): giu default la chay. Prod (synapseone.space): xem ghi chu PROD.
# Upgrade tu SynapseDX: ten moi la SYNAPSEONE_*; compose van doc SYNAPSEDX_*
# lam fallback, va cac service tu mirror SYNAPSEDX_* -> SYNAPSEONE_* khi boot.

# ---- domains (PROD: synapseone.space) ----
DOMAIN=synapseone.space
LE_EMAIL=admin@example.com
# Canonical app (frontend chinh): PROD=https://cloud.synapseone.space, dev=http://localhost:3000
CONSOLE_APP_URL=
# Web chinh/landing @: PROD=https://synapseone.space (chi de hien thi/docs)
CONSOLE_LANDING_URL=

# ---- TLS terminator (docker-compose.tls.yml, dev) ----
TLS_HOST_PORT=8443

# ---- console (management UI) ----
CONSOLE_HOST_PORT=3000
# PROD: https://api.synapseone.space
SYNAPSEONE_PUBLIC_BASE_URL=http://localhost:8080

# ---- host ports (doi khi chay nhieu stack tren 1 may) ----
# PROD: bind 127.0.0.1 (chi nginx :80/:443 public), vd 127.0.0.1:8080
GATEWAY_HOST_PORT=8080
IAM_HOST_PORT=4001
WORKFLOW_HOST_PORT=4002
AUTHENTIK_HTTP_PORT=19000
AUTHENTIK_HTTPS_PORT=19443

# ---- core ----
POSTGRES_DB=synapseone
POSTGRES_USER=synapseone
POSTGRES_PASSWORD=synapseone_password_change_me
# compose tu dung DATABASE_URL/REDIS_URL tu cac phan tren; 2 dong duoi chi dung khi chay service ngoai docker:
# DATABASE_URL=postgres://synapseone:synapseone_password_change_me@localhost:5432/synapseone
# REDIS_URL=redis://localhost:6379
REDIS_URL=redis://redis:6379

# ---- iam-service ----
IAM_JWT_SECRET=change_me_super_secret_32chars_min
IAM_JWT_EXPIRES_IN=3600
IAM_REFRESH_EXPIRES_IN=2592000
# Pepper for API-key / refresh-token hashes at rest (HMAC-SHA256). Empty = plain
# SHA-256 (dev default). PRODUCTION: set a random 32+ char value; old keys created
# before the pepper was set keep working (legacy fallback on verify).
IAM_API_KEY_PEPPER=
# TOTP MFA: 32-byte key (hex or base64) that seals authenticator secrets at rest
# (AES-256-GCM). Empty = derived from IAM_JWT_SECRET. Generate: openssl rand -hex 32
IAM_MFA_ENCRYPTION_KEY=
# Issuer label shown in authenticator apps.
IAM_MFA_ISSUER=SynapseOne
# Sign-in lockout: N consecutive wrong passwords/MFA codes lock the user for S seconds.
IAM_LOGIN_MAX_FAILURES=5
IAM_LOGIN_LOCKOUT_SECONDS=900
# Per-IP request ceilings on POST /v1/auth/login and the MFA/unlock routes.
IAM_LOGIN_RATE_LIMIT_PER_MIN=60
IAM_MFA_RATE_LIMIT_PER_MIN=60
# Audit retention (days): hourly purge of audit_log rows older than N days.
# 0 = disabled (default, zero behavior change). Production: e.g. 180.
AUDIT_RETENTION_DAYS=0
# Data-plane mutation audit (Base/Faststore/Queue/Stream/Workflow): one event
# per write, batched to IAM POST /v1/audit/ingest. false disables it (dev only).
AUDIT_TRAIL=true
# Override the audit sink (default: ${IAM_SERVICE_URL}/v1/audit/ingest).
AUDIT_INGEST_URL=
# PROD: false (chi con OIDC/API key)
IAM_ALLOW_DEV_LOGIN=true
# Demo OIDC callback trusts caller-supplied email (impersonation possible).
# Dev default true. PRODUCTION: set false (endpoint then requires a real IdP `code`).
IAM_ALLOW_OIDC_DEMO_CALLBACK=true
# OIDC upstream (Authentik mac dinh, co the doi sang Keycloak)
OIDC_PROVIDER=authentik
# Public HTTPS issuer that a BROWSER can reach (Authentik/Keycloak). The
# internal Docker host (http://authentik-server:9000) is NOT reachable from the
# internet and is rejected in production. In dev, dev login is available.
OIDC_ISSUER=https://auth.synapseone.space/application/o/synapseone/
OIDC_CLIENT_ID=synapseone-platform
OIDC_CLIENT_SECRET=change_me_oidc_secret
# Optional allowlist of org slugs allowed through OIDC (comma-separated).
# Empty = any slug may federate; a NEW slug is then self-service, while joining
# an EXISTING org always requires an existing membership. Set it in production
# to pin federation to your own org(s).
OIDC_ALLOWED_ORGS=
# HMAC key rieng cho OIDC state (chong CSRF). PROD: random 32+ ky tu (khac JWT secret).
# De trong = fallback IAM_JWT_SECRET (dev default).
OIDC_STATE_SECRET=
# PROD: the Console page that completes the SSO round-trip, e.g.
# https://cloud.synapseone.space/oidc/callback (via gateway). The page POSTs the
# single-use code to the API — never use a bare API URL users can't reach.
OIDC_REDIRECT_URI=http://localhost:3000/oidc/callback

# ---- gateway ----
# NOTE: gateway rate limiting da go (quyet dinh van hanh) — rate-limit o
# Ingress/WAF/reverse proxy. Muon bat lai: revert commit go limiter.
GATEWAY_PORT=8080
GATEWAY_ROUTES_PATH=./routes.yaml
IAM_SERVICE_URL=http://iam:4001
WORKFLOW_SERVICE_URL=http://workflow:4002
AI_SERVICE_URL=http://ai:4003
INFERENCE_SERVICE_URL=http://inference:4008
# Per-tenant AI quota (requests/minute); 429 + Retry-After when exceeded.
INFERENCE_RATE_LIMIT_PER_MIN=60
# Express trust proxy: empty/0 = direct exposure, 1 = one nginx/Ingress hop,
# or a CIDR list (e.g. loopback,172.16.0.0/12). `true` is rejected.
TRUST_PROXY=
LDS_SERVICE_URL=http://lds:4004
BASE_SERVICE_URL=http://base:4005
FASTSTORE_SERVICE_URL=http://faststore:4006
QUEUE_SERVICE_URL=http://queue:4007
# PROD: true (verify tap trung, fail-closed). Default true tu 0.3.2 (fail-closed);
# chi dat false khi dev cuc bo + hieu rui ro (bat ky X-API-Key nao cung qua).
GATEWAY_VERIFY_APIKEY=true
PROXY_TIMEOUT_MS=30000
# PROD: https://cloud.synapseone.space,https://synapseone.space
CORS_ORIGIN=
# Shared service-to-service credential (gateway -> iam + workflow + ai). Empty = dev
# mode (services warn at startup). PRODUCTION: set random 32+ chars on ALL FOUR
# services (same value) and do not publish internal host ports.
# 32-byte hex key for the encrypted credential/secret vault (openssl rand -hex 32).
# Required in production; empty uses an ephemeral dev key.
SYNAPSEONE_CREDENTIAL_KEY=
# Optional shared token for POST /v1/secrets/rotation-webhook.
SECRET_ROTATION_WEBHOOK_SECRET=

SYNAPSEONE_INTERNAL_SECRET=
# Send Strict-Transport-Security. Only enable behind TLS (docker-compose.tls.yml).
# PROD: true
HSTS_ENABLED=false

# ---- workflow-service (local built-in engine, no external dependency) ----
# Cron scheduler tick (ms): how often active cron workflows are checked.
WORKFLOW_CRON_TICK_MS=15000
# Hard execution budget for workflows without `settings.timeoutMs` (1s..300s).
WORKFLOW_TIMEOUT_MS=60000
# Per-call budget for workflow -> inference LLM requests (1s..300s). Reasoning
# models can spend 30s+ per turn before returning a tool call or final answer.
INFERENCE_TIMEOUT_MS=120000
# Service credential for `synapseone.api` IAM nodes (users/roles/policies/audit).
# IAM requires a real caller credential even when the internal secret is present
# (`x-synapseone-internal` proves gateway-origin, not identity). Create an API key
# on the workflow service account (IAM: POST /v1/accounts/:accountId/keys, scope
# `*`) and set it here. Empty = those nodes fail with a clear configuration error.
SYNAPSEONE_IAM_API_KEY=

# ---- object storage S3-compatible (S3Mock mac dinh; prod co the doi sang MinIO/S3 that) ----
S3_ENDPOINT=http://s3:9090
S3_BUCKET=synapseone-core
S3_REGION=us-east-1
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_HOST_PORT=9090

# ---- central authorization (gateway → IAM policies) ----
# off = tenant isolation only; audit = evaluate + log would-deny (default);
# enforce = deny with 403 access_denied (IAM unreachable → 503).
AUTHZ_MODE=audit
AUTHZ_CACHE_TTL_MS=30000

# ---- authentik (IdP; dot nay noi bo, public sau khi wired OIDC code-exchange that) ----
AUTHENTIK_POSTGRESQL__HOST=postgres
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=authentik_pw_change_me
AUTHENTIK_REDIS__HOST=redis
AUTHENTIK_SECRET_KEY=change_me_authentik_secret_key_60chars_min_xxxxxxxxxxxxxxxx
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# ---- monitoring (Prometheus) ----
# Dev: mo http://localhost:9091 (Prometheus graph/alerts UI).
# PROD: unpublish port qua overlay (xem docker-compose.prod.yml),
# truy cap bang port-forward/SSH tunnel.
PROMETHEUS_HOST_PORT=9091

# ---- sdk / demo ----
DEMO_ORG_SLUG=acme
DEMO_ACCOUNT_SLUG=prod

# ---- ai-service (agent hỗ trợ test API trên Console → API Docs) ----
# OpenAI-compatible provider (OpenRouter mặc định). Key ở SERVER-SIDE,
# không bao giờ xuống browser.
AI_SERVICE_HOST_PORT=127.0.0.1:4003
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=change_me_openrouter_api_key
AI_DECISION_MODEL=inception/mercury-2.5
AI_LLM_MODEL=liquid/lfm-2.5-2.6b:free
# Fallback model (different provider = uncorrelated outages) for generate/guide
# after the primary exhausts retries. Default = decision model. Empty disables.
AI_LLM_FALLBACK_MODEL=inception/mercury-2.5
AI_TIMEOUT_MS=20000
AI_RATE_LIMIT=30
AI_RETRIES=2

# ---- inference-service (Synapse Inference Engine: LLM + Embedding + Decision) ----
INFERENCE_SERVICE_HOST_PORT=127.0.0.1:4008
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
DECISION_MODEL_NAME=vllm-sr/Decision-2.0-Eos-0.8B
INFERENCE_DEVICE=auto

# ---- lds-service (SynapseLDS — linked data / NGSI-LD exports) ----
# PROD: unpublish port qua overlay (xem docker-compose.prod.yml).
LDS_SERVICE_HOST_PORT=127.0.0.1:4004

# ---- base-service (SynapseBase — document DB + object<->data mapping) ----
# PROD: unpublish port qua overlay (xem docker-compose.prod.yml).
BASE_SERVICE_HOST_PORT=127.0.0.1:4005
# Max serialized size of a document's data/object payload (bytes).
BASE_MAX_DOCUMENT_BYTES=262144
# Max documents scanned per query before returning 413 (keep queries indexed/narrow).
BASE_QUERY_SCAN_LIMIT=200000

# ---- faststore-service (Synapse Faststore — Redis-backed cache/KV) ----
# PROD: unpublish port qua overlay (xem docker-compose.prod.yml).
FASTSTORE_SERVICE_HOST_PORT=127.0.0.1:4006
# Dedicated Redis URL (falls back to REDIS_URL). Use a separate Redis DB/instance
# in production to isolate cache eviction from queue workloads.
FASTSTORE_REDIS_URL=redis://redis:6379

# ---- queue-service (SynapseQueue — message queue, dead letters) ----
# PROD: unpublish port qua overlay (xem docker-compose.prod.yml).
QUEUE_SERVICE_HOST_PORT=127.0.0.1:4007
QUEUE_REDIS_URL=redis://redis:6379
# Max serialized message payload (bytes), 1KB..1MB.
QUEUE_MAX_PAYLOAD_BYTES=262144


# ---- SynapseOCS (bucket-aware object cloud storage) ----
# STORAGE_S3_ACCESS_KEY/SECRET_KEY are also the SeaweedFS identity (letters/digits; set real values in prod).
OCS_SERVICE_URL=http://ocs:4010
# Public base used by HMAC-signed OCS URLs (set https://api... in production).
OCS_PUBLIC_BASE_URL=http://localhost:8080
STORAGE_BACKEND=s3
STORAGE_S3_ENDPOINT=http://s3:9090
STORAGE_S3_BUCKET=synapseone-core
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=test
STORAGE_S3_SECRET_KEY=test
STORAGE_S3_PATH_STYLE=true
STORAGE_FS_ROOT=/data
STORAGE_MAX_OBJECT_BYTES=26214400
STORAGE_TENANT_QUOTA_BYTES=5368709120
STORAGE_ALLOWED_CONTENT_TYPES=
STORAGE_HOST_PORT=127.0.0.1:4010

# ---- notifications-service (SynapseNotifications — outbox + delivery) ----
# PROD: DATABASE_URL is required; delivery goes through SynapseQueue.
NOTIFICATIONS_QUEUE_URL=http://queue:4007
NOTIFICATIONS_QUEUE_NAME=notifications
NOTIFICATIONS_MAX_ATTEMPTS=5
NOTIFICATIONS_RETRY_BASE_SECONDS=5
NOTIFICATIONS_RATE_LIMIT_PER_MIN=120
# Operator-provided HTTP relays (SES/Twilio/FCM/SMTP bridge, etc.).
NOTIFICATIONS_EMAIL_RELAY_URL=
NOTIFICATIONS_SMS_RELAY_URL=
NOTIFICATIONS_PUSH_RELAY_URL=
NOTIFICATIONS_HOST_PORT=127.0.0.1:4011

# ---- Backups (pg-backup + s3-backup services) ----
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
# BACKUP_DATABASES="synapseone authentik"
