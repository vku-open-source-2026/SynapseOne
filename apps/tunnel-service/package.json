{
  "name": "@synapseone/tunnel-service",
  "version": "0.9.0",
  "license": "Apache-2.0",
  "description": "Self-hosted HTTP reverse tunnel control plane, ingress, and outbound-only connector",
  "main": "dist/index.js",
  "bin": {
    "synapse-tunnel-server": "dist/index.js",
    "synapse-tunnel-api": "dist/control-plane.js",
    "synapse-tunnel-ingress": "dist/ingress-main.js",
    "synapse-tunnel-connector": "dist/connector.js"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "start:api": "node dist/control-plane.js",
    "start:ingress": "node dist/ingress-main.js",
    "start:connector": "node dist/connector.js",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "express": "4.22.3",
    "ws": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.19.25",
    "@types/ws": "8.18.1",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  }
}
